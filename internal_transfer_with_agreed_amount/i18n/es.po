"The payment accounts for the outbound and inbound methods must be different."
msgstr ""
"Las cuentas de pago de los métodos de envío y recepción deben ser "
"diferentes."

#. module: internal_transfer_with_agreed_amount
#. odoo-python
#: code:addons/internal_transfer_with_agreed_amount/wizards/internal_transfer_multicurrency.py:0
msgid "The source and destination journals must be different."
msgstr "Los diarios de origen y destino deben ser diferentes."

#. module: internal_transfer_with_agreed_amount
#. odoo-python
#: code:addons/internal_transfer_with_agreed_amount/wizards/internal_transfer_multicurrency.py:0
