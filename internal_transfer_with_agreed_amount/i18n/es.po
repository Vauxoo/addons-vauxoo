"The following payments are already matched to a bank statement line and "
"cannot be reset to draft: %s"
msgstr ""
"Los siguientes pagos ya están conciliados con una línea de estado de cuenta "
"bancario y no pueden restablecerse a borrador: %s"

#. module: internal_transfer_with_agreed_amount
#. odoo-python
#: code:addons/internal_transfer_with_agreed_amount/wizards/internal_transfer_multicurrency.py:0
msgid "The inbound payment method must have an account configured."
msgstr "El método de pago de recepción debe tener una cuenta configurada."

#. module: internal_transfer_with_agreed_amount
#. odoo-python
#: code:addons/internal_transfer_with_agreed_amount/wizards/internal_transfer_multicurrency.py:0
msgid "The outbound payment method must have an account configured."
msgstr "El método de pago de envío debe tener una cuenta configurada."

#. module: internal_transfer_with_agreed_amount
#. odoo-python
#: code:addons/internal_transfer_with_agreed_amount/wizards/internal_transfer_multicurrency.py:0
