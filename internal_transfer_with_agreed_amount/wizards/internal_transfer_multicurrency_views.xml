<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_internal_transfer_multicurrency" model="ir.ui.view">
        <field name="name">internal.transfer.multicurrency</field>
        <field name="model">internal.transfer.multicurrency</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="company_id" readonly="True" />
                    <field
                        name="company_currency_id"
                        string="Company Currency"
                        readonly="True"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <field name="date" />
                    <field name="memo" />
                </group>
                <group>
                    <group string="Sending Transaction">
                        <field name="out_journal_id" string="Journal" />
                        <field name="out_currency_locked" invisible="True" />
                        <label for="out_amount_currency" string="Amount" />
                        <div class="o_row" name="out_amount_currency_div">
                            <field name="out_amount_currency" nolabel="1" />
                            <field
                                name="out_currency_id"
                                readonly="out_currency_locked"
                                nolabel="1"
                                options="{'no_create': True, 'no_open': True}"
                            />
                        </div>
                        <field name="out_amount" string="Local Amount" />
                        <field name="out_payment_method_line_id" string="Payment Method" />
                    </group>
                    <group string="Receiving Transaction">
                        <field name="in_journal_id" string="Journal" />
                        <field name="in_currency_locked" invisible="True" />
                        <label for="in_amount_currency" string="Amount" />
                        <div class="o_row" name="in_amount_currency_div">
                            <field name="in_amount_currency" nolabel="1" />
                            <field
                                name="in_currency_id"
                                readonly="in_currency_locked"
                                nolabel="1"
                                options="{'no_create': True, 'no_open': True}"
                            />
                        </div>
                        <field name="in_amount" string="Local Amount" readonly="True" />
                        <field name="in_payment_method_line_id" string="Payment Method" />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_create_internal_transfer"
                        string="Create Internal Transfer"
                        type="object"
                        class="btn-primary"
                        invisible="not out_journal_id
                                   or not out_currency_id
                                   or not out_amount_currency
                                   or not out_amount
                                   or not out_payment_method_line_id
                                   or not in_journal_id
                                   or not in_currency_id
                                   or not in_amount_currency
                                   or not in_payment_method_line_id"
                    />
                    <button string="Close" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_internal_transfer_multicurrency" model="ir.actions.act_window">
        <field name="name">Specify the agreed amount</field>
        <field name="res_model">internal.transfer.multicurrency</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
