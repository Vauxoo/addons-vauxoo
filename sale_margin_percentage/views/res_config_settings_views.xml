<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.margin</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pricing_setting_container']" position="inside">
                <setting
                    id="margin_percentage"
                    string="Margin Threshold"
                    help="Minimum margin percentage allowed"
                    groups="base.group_no_one"
                >
                    <field name="margin_threshold" widget="percentage" />
                </setting>
            </xpath>
       </field>
    </record>

</odoo>
